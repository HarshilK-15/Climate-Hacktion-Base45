# Copy this file to the PROJECT FOLDER (next to README.md) and name the copy exactly:  .env
# Then paste your key after the = sign. Nothing else to change.
#
# .env is in .gitignore, so git never commits it. Check any time with:  python -m agent.llm --check
# Never put the key in code, in the web app, on the Pico, in chat, or on screen in the demo video.

GEMINI_API_KEY=

# Optional settings (remove the # to use one):
# SHIPLESS_MODEL=gemini-3.5-flash          # see the models your key can use: python -m agent.llm --models
# SHIPLESS_AI_MAX_CALLS_PER_HOUR=120       # abuse guard: past this, the app uses templates until the hour rolls over
# SHIPLESS_AI=off                          # emergency switch: templates only (e.g. bad Wi-Fi on demo day)
